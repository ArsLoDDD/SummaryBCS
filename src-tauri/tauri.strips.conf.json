{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Редактор позицій по смугах",
  "mainBinaryName": "StripsEditor",
  "identifier": "ua.summarybcs.strips",
  "build": {
    "beforeDevCommand": "npm run dev:strips",
