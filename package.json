{
  "name": "summary-bcs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode summary",
    "dev:template": "vite --mode template",
    "dev:editor": "vite --mode editor",
    "build": "tsc -b && vite build --mode summary",
    "build:template": "tsc -b && vite build --mode template",
    "build:editor": "tsc -b && vite build --mode editor",
    "build:all": "npm run build && npm run build:template && npm run build:editor",
    "build:ci": "npm run build && npm run build:editor",
    "preview": "vite preview",
    "tauri": "tauri",
    "app:summary": "npm run tauri:dev:summary",
    "app:template": "npm run tauri:dev:template",
    "app:editor": "npm run tauri:dev:editor",
    "build:exe:summary": "npm run tauri:build:summary",
    "build:exe:template": "npm run tauri:build:template",
    "build:exe:editor": "npm run tauri:build:editor",
    "tauri:dev:summary": "tauri dev",
    "tauri:dev:template": "tauri dev --config src-tauri/tauri.template.conf.json",
    "tauri:dev:editor": "tauri dev --config src-tauri/tauri.editor.conf.json",
    "tauri:build:summary": "tauri build --bundles nsis",
    "tauri:build:template": "tauri build --config src-tauri/tauri.template.conf.json --bundles nsis",
    "tauri:build:editor": "tauri build --config src-tauri/tauri.editor.conf.json --bundles nsis",
    "test": "vitest run",
    "lint": "eslint src --max-warnings=0",
    "check:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "test:ci": "npm run lint && npm run test && npm run build:ci && npm run check:rust && cargo test --manifest-path src-tauri/Cargo.toml",
    "test:full": "npm run lint && npm run test && npm run build:all && npm run check:rust && cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
